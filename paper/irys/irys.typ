// The hero: the shared benchmark's plate as irys renders it, with vcad's frozen mesh and, at
// every node that moves with the bore, its screen velocity coloured by its share of dL/dtheta.
// Every mark is data from `rose_brep` (HERO=data/hero); nothing is drawn by hand.
#let hero-tsv(name) = read("data/hero/" + name).split("\n").filter(l => l != "").map(l => l.split("\t").map(float))
#let fig-hero(width: 17.0) = {
  // crop to the part (the render's frame is the benchmark's camera, kept so the data are its own)
  let (ox, oy, cw, ch) = hero-tsv("crop.tsv").at(0)
  let k = width / cw
  let height = ch * k
  let edges = hero-tsv("edges.tsv")
  let nodes = hero-tsv("nodes.tsv")
  let cmax = calc.max(..nodes.map(n => calc.abs(n.at(4))))
  let xs = nodes.map(n => n.at(0))
  let ys = nodes.map(n => n.at(1))
  let (cx, cy) = ((calc.min(..xs) + calc.max(..xs)) / 2, (calc.min(..ys) + calc.max(..ys)) / 2)
  let rx = (calc.max(..xs) - calc.min(..xs)) / 2
  // the mesh fades in from left to right across the part: pixels, then the frozen plan
  let fade(x) = { let t = calc.clamp(((x - ox) / cw - 0.30) / 0.45, 0.0, 1.0); t * t * (3 - 2 * t) }
  let P(x, y) = ((x - ox) * k, height - (y - oy) * k)
  cetz.canvas(length: 1cm, {
    import cetz.draw: *
    content((0, 0), anchor: "south-west", image("data/hero/beauty-crop.png", width: width * 1cm))
    for e in edges {
      let a = fade((e.at(0) + e.at(2)) / 2)
      if a > 0.01 {
        line(P(e.at(0), e.at(1)), P(e.at(2), e.at(3)), stroke: 0.22pt + c-label.transparentize(100% - 70% * a))
      }
    }
    // each moving node: a tick along its screen velocity, as long as its share of dL/dtheta
    for n in nodes {
      let s = calc.abs(n.at(4)) / cmax
      if s > 0.03 {
        let col = if n.at(4) > 0 { c-sel } else { c-info }
        let v = calc.sqrt(n.at(2) * n.at(2) + n.at(3) * n.at(3))
        let len = 26.0 * s / v
        line(P(n.at(0), n.at(1)), P(n.at(0) + n.at(2) * len, n.at(1) + n.at(3) * len),
          stroke: (paint: col.transparentize(100% - (35% + 65% * s)), thickness: 0.4pt, cap: "round"))
      }
    }
    // the parameter, dimensioned across the bore's image
    let (l0, l1) = (P(cx - rx, cy), P(cx + rx, cy))
    line(l0, l1, stroke: 0.4pt + c-text, mark: (start: ">", end: ">", size: 0.11, fill: c-text))
    let lab = P(cx, cy)
    content((lab.at(0), lab.at(1) + 0.32), anchor: "south", text(font: mono-m, size: s-sm, fill: c-text)[Ø#nb\49.000#nb\mm#h(0.6em)#text(fill: c-label)[θ]])
    content((lab.at(0), lab.at(1) - 0.32), anchor: "north", text(font: mono-m, size: s-sm, fill: c-sel)[$partial cal(L) \/ partial theta$ = +#F("brep.pull", 2)])
  })
}

// The cover: rose full (vcad hardware/rose-full, streamlined) standing in the Barcelona Pavilion,
// rendered by irys's OpenPBR scene kernel, with its joint axes from rose-full.joints.json projected
// through the same camera (examples/paper_hero writes both). Scene: "Barcelona Pavillion" by
// eMirage, CC-BY, from blender.org's demo files.
#let fig-cover(width: 21.59) = {
  let rows = read("data/scene/annotation.tsv").split("\n").filter(l => l != "").map(l => l.split("\t"))
  let size = rows.find(r => r.at(0) == "size")
  let (pw, ph) = (float(size.at(1)), float(size.at(2)))
  let k = width / pw
  let height = ph * k
  let inv = json("data/scene/rose-full.joints.json")
  let lim = (:)
  for j in inv.joints { lim.insert(j.name, j.limits_deg) }
  let nparts = inv.links.values().map(l => l.parts.len()).sum()
  let P(x, y) = (x * k, height - y * k)
  let ok(r, i) = r.at(i) != "nan" and r.at(i + 1) != "nan"
  let joints = rows.filter(r => r.at(0) == "joint" and ok(r, 2) and ok(r, 4) and ok(r, 6))
  // the robot's right side faces the image's left, where the labels are, so no leader crosses the body
  let callouts = ("head_pitch", "r_shoulder_pitch", "r_elbow", "waist_yaw", "r_knee_pitch", "r_ankle_pitch")
  let pretty(n) = upper(if n.starts-with("r_") { "right " + n.slice(2) } else { n }.replace("_", " "))
  cetz.canvas(length: 1cm, {
    import cetz.draw: *
    content((0, 0), anchor: "south-west", image("data/scene/beauty.png", width: width * 1cm))
    // scrims under the type: the page's background, fading into the render
    rect((0, 0), (width * 0.42, height), stroke: none,
      fill: gradient.linear(c-bg.transparentize(18%), c-bg.transparentize(100%), angle: 0deg))
    rect((width * 0.55, 0), (width, height * 0.22), stroke: none,
      fill: gradient.linear(c-bg.transparentize(100%), c-bg.transparentize(25%), angle: 0deg))
    // every joint axis, ±80 mm about its pivot
    for r in joints {
      let (a, b) = (P(float(r.at(4)), float(r.at(5))), P(float(r.at(6)), float(r.at(7))))
      line(a, b, stroke: 0.35pt + c-info.transparentize(25%))
      circle(P(float(r.at(2)), float(r.at(3))), radius: 0.035, fill: c-info, stroke: none)
    }
    // callouts: a leader from the pivot to a label column on the left
    let col = 1.0
    let picked = callouts.map(n => joints.find(r => r.at(1) == n)).filter(r => r != none)
    let sorted = picked.sorted(key: r => float(r.at(3)))
    let y0 = height * 0.86
    let dy = height * 0.115
    for (i, r) in sorted.enumerate() {
      let piv = P(float(r.at(2)), float(r.at(3)))
      let ly = y0 - i * dy
      let knee = (piv.at(0) - 0.9, ly)
      line(piv, knee, (col + 4.6, ly), stroke: 0.3pt + c-text.transparentize(30%))
      circle(piv, radius: 0.07, stroke: 0.4pt + c-text, fill: none)
      let l = lim.at(r.at(1))
      content((col, ly + 0.05), anchor: "south-west", text(font: mono-m, size: s-xs, fill: c-text, tracking: track)[#str(i + 1) #h(0.4em) #pretty(r.at(1))])
      content((col, ly - 0.05), anchor: "north-west", text(font: mono-m, size: s-xs, fill: c-label, tracking: track)[#str(calc.round(l.at(0), digits: 1))° … #str(calc.round(l.at(1), digits: 1))°])
    }
    // the count block, from the inventory
    content((width - 0.9, 0.9), anchor: "south-east", align(right, text(font: mono-m, size: s-xs, fill: c-text, tracking: track)[
      ROSE FULL · #inv.joints.len() REVOLUTE JOINTS · #nparts PARTS \
      #text(fill: c-label)[VCAD HARDWARE/ROSE-FULL · RENDERED BY IRYS]]))
  })
}

// Recovery examples: three of the gate's parts, each from its three photographs (the first shown
// large), the fit's overlay (model outline on the crop, and the residual), and the programs.
#let fig-recon-examples() = {
  let ex = json("data/recon-examples.json")
  let verdict(e) = if e.p05 { text(fill: c-ok)[PASS · WORST #calc.round(e.max, digits: 2) MM] } else if e.p1 { text(fill: c-ok)[PASS AT 1 MM · #calc.round(e.max, digits: 2) MM] } else if e.topo { text(fill: c-fault)[FAIL · #calc.round(e.max, digits: 2) MM] } else { text(fill: c-fault)[FAIL · WRONG FEATURES] }
  let mono-s(body, fill: c-label) = text(font: mono, size: 5.6pt, fill: fill, body)
  align(left, grid(columns: (1fr,), row-gutter: 1.1em, ..ex.map(e => grid(
    columns: (1.05fr, 0.36fr, 1.9fr), column-gutter: 0.5em, row-gutter: 0.35em,
    image("images/recon/" + str(e.seed) + "-v0.jpg", width: 100%),
    stack(spacing: 0.3em, image("images/recon/" + str(e.seed) + "-v1.jpg", width: 100%), image("images/recon/" + str(e.seed) + "-v2.jpg", width: 100%)),
    image("images/recon/" + str(e.seed) + "-overlay.png", width: 100%),
    grid.cell(colspan: 3, stack(spacing: 0.35em,
      text(font: mono-m, size: s-xs, tracking: track)[PART #e.seed #h(0.6em) #verdict(e)],
      mono-s[TRUTH #h(0.5em) #e.truth],
      mono-s(fill: c-text)[FOUND #h(0.5em) #e.recovered.split("; pose").at(0)])),
  ))))
}

